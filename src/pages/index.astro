---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, contact, creditImpot, trustItems } from '../data/site';

const trustIconPaths = [
  'M12 2c-4 3-7 7-7 11a7 7 0 0 0 14 0c0-4-3-8-7-11Z M8 15c1 2 3 3 4 3',
  'M12 21s-7-4.35-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6C19 16.65 12 21 12 21Z',
  'M4 6h10M4 12h16M4 18h7 M17 4v4M9 10v4M17 16v4',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: 'Batchcooking à domicile : repas faits maison cuisinés chez vous par une cheffe, produits frais et de saison, sur mesure.',
  url: site.url,
  email: contact.email,
  priceRange: '€€',
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Métropole lilloise',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lille',
    addressRegion: 'Hauts-de-France',
    addressCountry: 'FR',
  },
  sameAs: [contact.instagramUrl],
};
---

<BaseLayout
  title="Batchcooking à domicile dans la métropole lilloise"
  description="Repas faits maison, cuisinés chez vous par une cheffe formée. Produits frais et de saison, sur mesure, 50% de crédit d'impôt immédiat. Métropole lilloise."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="rule"></span>
          {site.secteur}
        </p>
        <h1>{site.tagline}</h1>
        <p class="sub">Cuisine à domicile : des repas faits maison, <br />cuisinés chez vous par une cheffe.</p>
        <a href="/offre" class="cta-link">Découvrir l&rsquo;offre</a>
      </div>

      <div class="hero-photo-col">
        <img class="hero-photo" src="/images/photo-hero-landscape.webp" alt="Lola, La mère Simone, dans sa cuisine" />
        <div class="hero-credit">
          <span class="pct">{creditImpot.taux}%</span>
          <span class="desc">{creditImpot.label}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="container trust-row">
      {
        trustItems.map((item, i) => (
          <>
            <div class="trust-item">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={trustIconPaths[i]} />
              </svg>
              <div>
                <div class="t">{item.titre}</div>
                <div class="s">{item.sousTitre}</div>
              </div>
            </div>
            {i < trustItems.length - 1 && <div class="trust-divider" />}
          </>
        ))
      }
    </div>
  </section>

  <section class="about-teaser">
    <div class="container about-grid">
      <img class="about-photo" src="/images/photo-portrait.webp" alt="Lola, La mère Simone, en cuisine" />
      <div class="about-copy">
        <p class="eyebrow">Qui suis-je</p>
        <h2>Une cheffe formée, à votre service</h2>
        <p>
          Diplômée d&rsquo;un CAP Cuisine, je cuisine pour vous des repas faits maison à partir de produits
          frais et de saison. Je viens directement chez vous préparer les repas de la semaine, dans le
          respect de vos goûts et de vos éventuelles allergies.
        </p>
        <a href="/qui-suis-je" class="about-cta">En savoir plus sur mon parcours</a>
      </div>
    </div>
  </section>


</BaseLayout>

<style>
  .hero {
    background: linear-gradient(155deg, var(--color-wine) 0%, var(--color-mauve) 65%, var(--color-wine-deeper) 100%);
    color: #fff;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2.5rem;
    padding-block: clamp(3rem, 7vw, 4rem);
    min-height: 480px;
  }

  .hero-copy {
    max-width: 480px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-cream);
  }

  .rule {
    width: 22px;
    height: 1px;
    background: var(--color-cream);
    flex-shrink: 0;
  }

  .hero-copy h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.875rem, 5.6vw, 4.5rem);
    color: #fff;
  }

  .sub {
    margin-top: 1.35rem;
    font-size: 1.3125rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.5;
  }

  .cta-link {
    display: inline-block;
    margin-top: 2.1rem;
    background: var(--color-cream);
    color: var(--color-wine-deeper);
    padding: 1.1rem 2.25rem;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    border-bottom: 3px solid var(--color-olive);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .cta-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .hero-photo-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-self: center;
    gap: 1.15rem;
    width: 400px;
    max-width: 100%;
  }

  .hero-photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition);
  }

  .hero-photo-col:hover .hero-photo {
    transform: translateY(-4px);
  }

  .hero-credit {
    background: var(--color-cream);
    border-radius: var(--radius-md);
    padding: 2rem 1.75rem;
    width: 100%;
    text-align: left;
    box-shadow: var(--shadow-md);
  }

  .hero-credit .pct {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1;
    display: block;
    color: var(--color-wine);
  }

  .hero-credit .desc {
    display: block;
    margin-top: 0.85rem;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink-soft);
  }

  .trust {
    background: var(--color-cream-card);
    padding: 3rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .trust-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .trust-item .icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    color: var(--color-olive);
  }

  .trust-item .t {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-olive-dark);
    line-height: 1.3;
  }

  .trust-item .s {
    font-size: 0.9rem;
    color: var(--color-olive-dark);
    opacity: 0.75;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
  }

  .trust-divider {
    width: 1px;
    height: 36px;
    background: var(--color-line);
    flex-shrink: 0;
  }

  .about-teaser {
    padding: 3.5rem 0;
    background: var(--color-cream-card);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-photo {
    width: 100%;
    aspect-ratio: 8 / 7;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition);
  }

  .about-photo:hover {
    transform: translateY(-4px);
  }

  .about-copy h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.85rem, 3.2vw, 2.4rem);
    color: var(--color-wine);
  }

  .about-copy p {
    margin-top: 1.15rem;
    font-size: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
    max-width: 48ch;
  }

  .about-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.625rem;
    background: var(--color-olive-muted);
    color: var(--color-cream);
    padding: 1.125rem 2.25rem;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    border-bottom: 3px solid var(--color-olive);
    transition: transform var(--transition), box-shadow var(--transition), background var(--transition);
  }

  .about-cta:hover {
    background: var(--color-olive);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
      padding-top: 3rem;
    }

    .hero-photo-col {
      order: -1;
      width: 100%;
      max-width: 400px;
      min-width: 0;
      margin-inline: auto;
      padding-top: 0.5rem;
    }

    .hero-copy {
      max-width: none;
      min-width: 0;
    }

    .hero-copy .sub br {
      display: none;
    }

    .trust-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .trust-divider {
      display: none;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      aspect-ratio: 16 / 10;
    }
  }
</style>
