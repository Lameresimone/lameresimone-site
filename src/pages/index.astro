---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, contact, creditImpot, trustItems, avisClients } from '../data/site';

const trustIconPaths = [
  'M12 2c-4 3-7 7-7 11a7 7 0 0 0 14 0c0-4-3-8-7-11Z M8 15c1 2 3 3 4 3',
  'M12 21s-7-4.35-9.5-9A5.5 5.5 0 0 1 12 6a5.5 5.5 0 0 1 9.5 6C19 16.65 12 21 12 21Z',
  'M4 6h10M4 12h16M4 18h7 M17 4v4M9 10v4M17 16v4',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: 'Batchcooking à domicile : repas faits maison cuisinés chez vous par une cheffe, produits frais et de saison, sur mesure.',
  url: site.url,
  email: contact.email,
  priceRange: '€€',
  areaServed: {
    '@type': 'City',
    name: 'Lille',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lille',
    addressRegion: 'Hauts-de-France',
    addressCountry: 'FR',
  },
  sameAs: [contact.instagramUrl],
};
---

<BaseLayout
  title="Batchcooking à domicile à Lille"
  description="Repas faits maison, cuisinés chez vous par une cheffe formée. Produits frais et de saison, sur mesure, 50% de crédit d'impôt immédiat. Secteur Lille et alentours."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="rule"></span>
          {site.secteur}
        </p>
        <h1>{site.tagline}</h1>
        <p class="sub">{site.description}</p>
        <a href="/offre" class="cta-link">Découvrir l&rsquo;offre</a>
      </div>

      <div class="hero-photo-col">
        <img class="hero-photo" src="/images/photo-hero-landscape.webp" alt="Lola, La mère Simone, dans sa cuisine" />
        <div class="hero-credit">
          <span class="pct">{creditImpot.taux}%</span>
          <span class="desc">{creditImpot.label}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust">
    <div class="container trust-row">
      {
        trustItems.map((item, i) => (
          <>
            <div class="trust-item">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={trustIconPaths[i]} />
              </svg>
              <div>
                <div class="t">{item.titre}</div>
                <div class="s">{item.sousTitre}</div>
              </div>
            </div>
            {i < trustItems.length - 1 && <div class="trust-divider" />}
          </>
        ))
      }
    </div>
  </section>

  <section class="about-teaser">
    <div class="container about-grid">
      <img class="about-photo" src="/images/photo-portrait.webp" alt="Lola, La mère Simone, en cuisine" />
      <div class="about-copy">
        <p class="eyebrow">Qui suis-je</p>
        <h2>Une cheffe formée, à votre service</h2>
        <p>
          Diplômée d&rsquo;un CAP Cuisine, je cuisine pour vous des repas faits maison à partir de produits
          frais et de saison. Je viens directement chez vous préparer les repas de la semaine, dans le
          respect de vos goûts et de vos éventuelles allergies.
        </p>
        <a href="/qui-suis-je" class="about-cta">En savoir plus sur mon parcours →</a>
      </div>
    </div>
  </section>

  <section class="guide-banner">
    <div class="container guide-banner-inner">
      <div class="guide-banner-text">
        <p class="eyebrow">Guide offert</p>
        <h2>Téléchargez votre guide pour tout savoir sur le batchcooking à domicile</h2>
        <p>
          Le concept, les tarifs, et comment profiter de {creditImpot.taux}% de crédit d&rsquo;impôt immédiat
          — en un seul PDF.
        </p>
      </div>
      <button type="button" class="guide-banner-btn" id="open-guide-modal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Télécharger le guide
      </button>
    </div>
  </section>

  <section class="avis" id="avis">
    <div class="container">
      <div class="avis-head">
        <p class="eyebrow">Avis clients</p>
        <h2>Vos avis, ma plus belle vitrine</h2>
      </div>
      <div class="avis-grid">
        {
          avisClients.map((avis) => (
            <div class="avis-card">
              <div class="avis-stars">{'★'.repeat(avis.note)}{'☆'.repeat(5 - avis.note)}</div>
              <p class="avis-text">{avis.texte}</p>
              <p class="avis-author">
                <strong>{avis.nom}</strong>
              </p>
              {avis.placeholder && <span class="avis-placeholder-tag">Exemple à remplacer</span>}
            </div>
          ))
        }
      </div>
      <div class="avis-cta">
        <a href="#avis">Lire tous les avis →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<div class="guide-modal-overlay" id="guide-modal-overlay">
  <div class="guide-modal">
    <button type="button" class="guide-modal-close" id="guide-modal-close" aria-label="Fermer">×</button>
    <h3>Recevez votre guide gratuit</h3>
    <p>Le concept, les tarifs et le crédit d&rsquo;impôt, en un seul PDF. Indiquez votre email pour le télécharger.</p>
    <form name="guide" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/merci-guide">
      <input type="hidden" name="form-name" value="guide" />
      <p class="honeypot"><label>Ne pas remplir : <input name="bot-field" /></label></p>
      <div class="form-group">
        <label for="guide-prenom">Prénom</label>
        <input type="text" id="guide-prenom" name="prenom" required />
      </div>
      <div class="form-group">
        <label for="guide-email">Email</label>
        <input type="email" id="guide-email" name="email" required />
      </div>
      <button type="submit" class="guide-modal-submit">Recevoir mon guide</button>
      <p class="note">Pas de spam, juste votre guide — et éventuellement quelques conseils cuisine plus tard.</p>
    </form>
  </div>
</div>

<script>
  const guideOverlay = document.getElementById('guide-modal-overlay');
  const guideClose = document.getElementById('guide-modal-close');
  const guideOpen = document.getElementById('open-guide-modal');

  guideOpen?.addEventListener('click', () => guideOverlay?.classList.add('active'));
  guideClose?.addEventListener('click', () => guideOverlay?.classList.remove('active'));

  guideOverlay?.addEventListener('click', (event) => {
    if (event.target === guideOverlay) guideOverlay.classList.remove('active');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') guideOverlay?.classList.remove('active');
  });
</script>

<style>
  .hero {
    background: linear-gradient(155deg, var(--color-wine) 0%, var(--color-mauve) 65%, var(--color-wine-deeper) 100%);
    color: #fff;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2.5rem;
    padding-block: clamp(3rem, 7vw, 4rem);
    min-height: 480px;
  }

  .hero-copy {
    max-width: 480px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-cream);
  }

  .rule {
    width: 22px;
    height: 1px;
    background: var(--color-cream);
    flex-shrink: 0;
  }

  .hero-copy h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.875rem, 5.6vw, 4.5rem);
    color: #fff;
  }

  .sub {
    margin-top: 1.35rem;
    font-size: 1.3rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.5;
    max-width: 34ch;
  }

  .cta-link {
    display: inline-block;
    margin-top: 2.1rem;
    background: var(--color-cream);
    color: var(--color-wine-deeper);
    padding: 1.1rem 2.25rem;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    border-bottom: 3px solid var(--color-olive);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .cta-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .hero-photo-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-self: center;
    gap: 1.15rem;
    width: 400px;
    max-width: 100%;
  }

  .hero-photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition);
  }

  .hero-photo-col:hover .hero-photo {
    transform: translateY(-4px);
  }

  .hero-credit {
    background: var(--color-wine-deepest);
    border-radius: var(--radius-md);
    padding: 2rem 1.75rem;
    width: 100%;
    text-align: left;
    box-shadow: var(--shadow-md);
  }

  .hero-credit .pct {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1;
    display: block;
    color: var(--color-cream);
  }

  .hero-credit .desc {
    display: block;
    margin-top: 0.85rem;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    color: rgba(247, 240, 230, 0.85);
  }

  .trust {
    background: var(--color-cream-card);
    padding: 3rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .trust-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .trust-item .icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    color: var(--color-olive);
  }

  .trust-item .t {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-olive-dark);
    line-height: 1.3;
  }

  .trust-item .s {
    font-size: 0.9rem;
    color: var(--color-olive-dark);
    opacity: 0.75;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.15rem;
  }

  .trust-divider {
    width: 1px;
    height: 36px;
    background: var(--color-line);
    flex-shrink: 0;
  }

  .about-teaser {
    padding: clamp(4rem, 8vw, 5.5rem) 0;
    background: var(--color-cream-card);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition);
  }

  .about-photo:hover {
    transform: translateY(-4px);
  }

  .about-copy h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.85rem, 3.2vw, 2.4rem);
    color: var(--color-wine);
  }

  .about-copy p {
    margin-top: 1.15rem;
    font-size: 1rem;
    color: var(--color-ink-soft);
    line-height: 1.7;
    max-width: 48ch;
  }

  .about-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.65rem;
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--color-wine);
    text-decoration: none;
    border-bottom: 2px solid var(--color-olive);
    padding-bottom: 0.2rem;
    transition: color var(--transition);
  }

  .about-cta:hover {
    color: var(--color-wine-dark);
  }

  .avis {
    padding: clamp(4rem, 8vw, 5.5rem) 0;
  }

  .avis-head {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .avis-head h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.85rem, 3.2vw, 2.4rem);
    color: var(--color-wine);
  }

  .avis-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .avis-card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 1.85rem 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .avis-stars {
    color: var(--color-olive);
    font-size: 0.95rem;
    letter-spacing: 2px;
  }

  .avis-text {
    margin-top: 1rem;
    font-size: 0.92rem;
    color: var(--color-ink);
    line-height: 1.65;
    flex-grow: 1;
  }

  .avis-author {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .avis-author strong {
    color: var(--color-wine);
    font-weight: 800;
  }

  .avis-placeholder-tag {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-olive-dark);
    background: var(--color-cream-card);
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    width: fit-content;
  }

  .avis-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  .avis-cta a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1.5px solid var(--color-line);
    border-radius: 30px;
    padding: 0.875rem 1.625rem;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-wine);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition);
  }

  .avis-cta a:hover {
    border-color: var(--color-wine);
    background: var(--color-cream-card);
  }

  .guide-banner {
    background: var(--color-olive);
    padding: 3rem 0;
  }

  .guide-banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .guide-banner-text {
    max-width: 520px;
  }

  .guide-banner-text .eyebrow {
    color: rgba(255, 255, 255, 0.7);
  }

  .guide-banner-text h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    color: #fff;
  }

  .guide-banner-text p {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
  }

  .guide-banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    background: var(--color-cream);
    color: var(--color-olive-dark);
    padding: 1rem 1.75rem;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .guide-banner-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .guide-banner-btn svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 3rem;
    }

    .hero-photo-col {
      order: -1;
      margin-inline: auto;
      padding-top: 0.5rem;
    }

    .hero-copy {
      max-width: none;
    }

    .trust-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .trust-divider {
      display: none;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      aspect-ratio: 16 / 10;
    }

    .avis-grid {
      grid-template-columns: 1fr;
    }

    .guide-banner-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .guide-banner-btn {
      width: 100%;
      justify-content: center;
    }
  }

  .guide-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(42, 33, 24, 0.55);
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }

  .guide-modal-overlay.active {
    display: flex;
  }

  .guide-modal {
    background: #fff;
    border-radius: var(--radius-md);
    max-width: 440px;
    width: 100%;
    padding: 2.25rem 2rem;
    position: relative;
  }

  .guide-modal-close {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: var(--color-cream-card);
    color: var(--color-ink-soft);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
    line-height: 1;
    transition: background var(--transition);
  }

  .guide-modal-close:hover {
    background: var(--color-line);
  }

  .guide-modal h3 {
    font-size: 1.25rem;
    color: var(--color-wine);
    max-width: 26ch;
  }

  .guide-modal p {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  .guide-modal form {
    margin-top: 1.375rem;
  }

  .guide-modal .form-group {
    margin-bottom: 0.875rem;
  }

  .guide-modal label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 0.375rem;
  }

  .guide-modal input[type='text'],
  .guide-modal input[type='email'] {
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.875rem;
    color: var(--color-ink);
    background: var(--color-cream);
    transition: border-color var(--transition), background var(--transition);
  }

  .guide-modal input:focus {
    outline: none;
    border-color: var(--color-wine);
    background: #fff;
  }

  .guide-modal-submit {
    width: 100%;
    margin-top: 0.375rem;
    background: var(--color-wine);
    color: #fff;
    border: none;
    padding: 0.9375rem;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-weight: 800;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background var(--transition), transform var(--transition);
  }

  .guide-modal-submit:hover {
    background: var(--color-wine-dark);
    transform: translateY(-1px);
  }

  .guide-modal .note {
    margin-top: 0.75rem;
    font-size: 0.72rem;
    color: var(--color-ink-soft);
    text-align: center;
  }

  .guide-modal .honeypot {
    position: absolute;
    left: -9999px;
  }
</style>
