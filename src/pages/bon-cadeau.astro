<script>
  const form = document.getElementById('gift-form') as HTMLFormElement | null;

  if (form) {
    const state: Record<'ep' | 'pd' | 'go', number> = { ep: 0, pd: 0, go: 0 };

    function eur(n: number) {
      const s = (Math.round(n * 100) / 100).toString().replace('.', ',');
      return `${s}€`;
    }

    function update() {
      if (!form) return;
      const checkedFormule = form.querySelector<HTMLInputElement>('input[name=formule]:checked');
      const courses = document.getElementById('opt-courses') as HTMLInputElement | null;
      if (!checkedFormule || !courses) return;

      const lines: [string, number][] = [];
      let valeur = 0;

      const fv = Number(checkedFormule.dataset.valeur);
      valeur += fv;
      lines.push([checkedFormule.dataset.name ?? '', fv]);

      if (state.ep) {
        valeur += 20 * state.ep;
        lines.push([`${state.ep} personne${state.ep > 1 ? 's' : ''} en plus`, 20 * state.ep]);
      }
      if (courses.checked) {
        valeur += 40;
        lines.push(['Je fais vos courses', 40]);
      }
      if (state.pd) {
        valeur += 15 * state.pd;
        lines.push([`${state.pd} petit${state.pd > 1 ? 's' : ''} déjeuner${state.pd > 1 ? 's' : ''}`, 15 * state.pd]);
      }
      if (state.go) {
        valeur += 15 * state.go;
        lines.push([`${state.go} goûter${state.go > 1 ? 's' : ''}`, 15 * state.go]);
      }

      const offrez = valeur / 2;

      const sumLines = document.getElementById('sum-lines');
      if (sumLines) {
        sumLines.innerHTML = lines
          .map(([label, amount]) => `<li><span>${label}</span><span>${eur(amount)}</span></li>`)
          .join('');
      }

      const setText = (id: string, value: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
      };
      const setValue = (id: string, value: string) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el) el.value = value;
      };

      setText('sum-valeur', eur(valeur));
      setText('sum-offrez', eur(offrez));
      setValue('f-valeur', eur(valeur));
      setValue('f-virer', eur(offrez));
      setText('sum-plein', eur(valeur));
      setValue('f-plein', eur(valeur));
      setValue('f-recap', lines.map(([label]) => label).join(' + '));
    }

    form.querySelectorAll<HTMLInputElement>('input[name=formule], #opt-courses').forEach((input) => {
      input.addEventListener('change', update);
    });

    form.querySelectorAll<HTMLElement>('.stepper').forEach((stepper) => {
      const key = stepper.dataset.target as 'ep' | 'pd' | 'go' | undefined;
      if (!key) return;
      stepper.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
        button.addEventListener('click', () => {
          const delta = Number(button.dataset.d);
          state[key] = Math.max(0, Math.min(4, state[key] + delta));
          const out = document.getElementById(`out-${key}`);
          const hidden = document.getElementById(`in-${key}`) as HTMLInputElement | null;
          if (out) out.textContent = String(state[key]);
          if (hidden) hidden.value = String(state[key]);
          update();
        });
      });
    });

    update();

    const btn = document.getElementById('gift-submit') as HTMLButtonElement | null;
    const fine = document.getElementById('gift-fine');
    const sent = document.getElementById('gift-sent') as HTMLElement | null;
    const err = document.getElementById('gift-err') as HTMLElement | null;

    function showSent() {
      if (btn) btn.hidden = true;
      if (fine) fine.hidden = true;
      if (err) err.hidden = true;
      if (sent) sent.hidden = false;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (!btn) return;

      btn.disabled = true;
      btn.textContent = 'Envoi en cours...';
      if (err) err.hidden = true;

      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString(),
      })
        .then((response) => {
          if (!response.ok) throw new Error('submit failed');
          showSent();
        })
        .catch(() => {
          btn.disabled = false;
          btn.textContent = 'Recevoir mon bon par mail';
          if (err) err.hidden = false;
        });
    });
  }
</script>

