---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import StepCard from '../components/StepCard.astro';
import PricingCard from '../components/PricingCard.astro';
import { site, beneficesOffre, etapesCommentCaMarche, formules } from '../data/site';
---

<BaseLayout title="L'offre" description="Découvrez les formules de batchcooking à domicile de La mère Simone.">
  <section class="intro">
    <div class="container intro-grid">
      <div class="intro-text">
        <h1>{site.tagline}</h1>
        <p>
          Je viens cuisiner chez vous tous vos repas de la semaine ! Vous choisissez votre formule et je
          m&rsquo;occupe du reste
        </p>
        <p class="secteur">Secteur {site.secteur}</p>
      </div>

      <img class="intro-photo" src="/images/photo-offre.jpg" alt="Lola, La mère Simone" />

      <div class="intro-badges">
        {
          beneficesOffre.map((benefice) => (
            <Card variant="mauve">
              {
                benefice.texte.split('\n').map((ligne, i) => (
                  <>
                    {i > 0 && <br />}
                    {ligne}
                  </>
                ))
              }
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="comment-ca-marche">
    <div class="container">
      <h2>Comment ça marche ?</h2>
      <div class="steps-grid">
        {etapesCommentCaMarche.map((etape) => <StepCard {...etape} />)}
      </div>
    </div>
  </section>

  <section class="formules">
    <div class="container">
      <h2>Les formules</h2>
      <div class="formules-grid">
        {formules.map((formule) => <PricingCard formule={formule} />)}
      </div>
      <a class="btn btn-block" href="/contact">Demander mon devis</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    background: var(--color-cream);
    padding-block: var(--space-section);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr auto;
    gap: 2rem;
    align-items: start;
  }

  .intro-text h1 {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    margin-bottom: 1.25rem;
  }

  .intro-text p {
    font-size: 1.05rem;
    max-width: 34ch;
    margin-bottom: 1rem;
  }

  .secteur {
    font-style: italic;
  }

  .intro-photo {
    border-radius: var(--radius-lg);
    align-self: center;
  }

  .intro-badges {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .comment-ca-marche {
    background: var(--color-olive);
    color: var(--color-cream);
    padding-block: var(--space-section);
  }

  .comment-ca-marche h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 2rem;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .formules {
    background: var(--color-cream);
    padding-block: var(--space-section);
    text-align: center;
  }

  .formules h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 2rem;
  }

  .formules-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 320px));
    gap: 1.5rem;
    justify-content: center;
    margin-bottom: 2rem;
    text-align: left;
  }

  @media (max-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }

    .steps-grid,
    .formules-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
