---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheckIcon from '../components/CheckIcon.astro';
import StepCard from '../components/StepCard.astro';
import PricingPlan from '../components/PricingPlan.astro';
import {
  site,
  creditImpot,
  beneficesOffre,
  etapesCommentCaMarche,
  formules,
  engagementModes,
  advantageItems,
  profilsOffre,
} from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Batchcooking à domicile',
  provider: {
    '@type': 'LocalBusiness',
    name: site.name,
    url: site.url,
  },
  areaServed: {
    '@type': 'City',
    name: 'Lille',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Formules de batchcooking',
    itemListElement: formules.map((formule) => ({
      '@type': 'Offer',
      name: formule.nom,
      description: `${formule.nbPlats} plats cuisinés prêts à déguster, pour ${formule.nbPortions} portions.`,
      price: String(formule.prix.ponctuel.client),
      priceCurrency: 'EUR',
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: String(formule.prix.ponctuel.client),
        priceCurrency: 'EUR',
        description: "Prix après 50% de crédit d'impôt immédiat, hors prix des courses.",
      },
    })),
  },
};
---

<BaseLayout
  title="L'offre"
  description="Découvrez les formules de batchcooking à domicile de La mère Simone."
  canonicalPath="/offre"
  jsonLd={jsonLd}
>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">
        <span class="rule"></span>
        Le concept
        <span class="rule"></span>
      </p>
      <h1>{site.tagline}</h1>
      <p class="intro">
        Je viens cuisiner chez vous tous vos repas de la semaine ! Vous choisissez votre formule et je
        m&rsquo;occupe du reste.
      </p>
      <div class="ph-region">
        <svg viewBox="0 0 20 20" fill="none">
          <path
            d="M10 18s6-5.5 6-10.2A6 6 0 0 0 4 7.8C4 12.5 10 18 10 18Z"
            stroke="currentColor"
            stroke-width="1.4"
          />
          <circle cx="10" cy="7.8" r="2.1" stroke="currentColor" stroke-width="1.4" />
        </svg>
        Secteur {site.secteur}
      </div>
    </div>
  </section>

  <section class="concept-details">
    <div class="container concept-grid">
      <div class="benefit-list">
        {
          beneficesOffre.map((benefice) => (
            <div class="benefit-row">
              <CheckIcon />
              <span>{benefice}</span>
            </div>
          ))
        }
        <div class="benefit-row highlight">
          <span class="pct">{creditImpot.taux}%</span>
          <span class="desc">{creditImpot.label}</span>
        </div>
      </div>

      <img class="ph-photo" src="/images/photo-offre.webp" alt="Lola, La mère Simone, range les plats préparés au réfrigérateur" />
    </div>
  </section>

  <section class="how">
    <div class="container">
      <div class="how-head">
        <p class="eyebrow eyebrow-light">Le déroulé</p>
        <h2>Comment ça marche ?</h2>
      </div>
      <div class="steps-grid">
        {etapesCommentCaMarche.map((etape) => <StepCard {...etape} />)}
      </div>
    </div>
  </section>

  <section class="pricing">
    <div class="container">
      <div class="pricing-head">
        <p class="eyebrow">Tarifs</p>
        <h2>Les formules</h2>
      </div>

      <div class="pricing-toggle" id="pricing-toggle">
        {
          engagementModes.map((mode, i) => (
            <button class="toggle-pill" class:list={{ active: i === 0 }} data-mode={mode.id}>
              {mode.label}
              {mode.remise && <span class="save">{mode.remise}</span>}
            </button>
          ))
        }
      </div>

      <div class="plans">
        {formules.map((formule) => <PricingPlan formule={formule} />)}
      </div>

      <div class="pricing-cta">
        <a href="/contact" class="cta-link">Demander mon devis</a>
      </div>
    </div>
  </section>

  <section class="advantage-banner">
    <div class="container advantage-row">
      {
        advantageItems.map((item, i) => (
          <>
            <div class="advantage-item">
              <div class="advantage-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={item.icone} />
                </svg>
              </div>
              <div>
                <div class="t">{item.titre}</div>
                <div class="s">{item.soustitre}</div>
              </div>
            </div>
            {i < advantageItems.length - 1 && <div class="advantage-divider" />}
          </>
        ))
      }
    </div>
  </section>

  <section class="pour-qui">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Pour qui ?</p>
        <h2>Un service pensé pour chaque quotidien</h2>
      </div>
      <div class="profil-grid">
        {
          profilsOffre.map((profil) => (
            <div class="profil-card">
              <div class="profil-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={profil.icone} />
                </svg>
              </div>
              <h3>{profil.titre}</h3>
              <p class="profil-pain">{profil.pain}</p>
              <p class="profil-solution">
                {profil.solutionAvant}
                <strong>{profil.solutionStrong}</strong>
                {profil.solutionApres}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const savingsText: Record<string, string> = {
    ponctuel: '',
    mensuel2: 'Engagement 2 séances/mois',
    mensuel4: 'Engagement 4 séances/mois — meilleur prix',
  };

  const pills = document.querySelectorAll<HTMLButtonElement>('#pricing-toggle .toggle-pill');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      const mode = pill.dataset.mode ?? 'ponctuel';
      const suffix = mode === 'ponctuel' ? '' : mode === 'mensuel2' ? '2' : '4';

      document.querySelectorAll('.plan').forEach((plan) => {
        const priceEl = plan.querySelector<HTMLElement>('.price');
        const realEl = plan.querySelector<HTMLElement>('.price-note strong');
        const slot = plan.querySelector<HTMLElement>('.price-savings-slot');
        if (!priceEl || !realEl || !slot) return;

        const client = priceEl.dataset[suffix ? `client${suffix}` : 'client'];
        const real = realEl.dataset[suffix ? `real${suffix}` : 'real'];
        priceEl.textContent = `${client}€`;
        realEl.textContent = `${real}€`;
        slot.innerHTML = mode === 'ponctuel' ? '' : `<span class="price-savings">${savingsText[mode]}</span>`;
      });
    });
  });
</script>

<style>
  .page-header {
    background: linear-gradient(155deg, var(--color-wine) 0%, var(--color-mauve) 65%, var(--color-wine-deeper) 100%);
    color: #fff;
    padding: clamp(1.85rem, 4vw, 2.1rem) 0 clamp(2.1rem, 4vw, 2.4rem);
    text-align: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: var(--color-cream);
    font-size: 0.75rem;
  }

  .rule {
    width: 22px;
    height: 1px;
    background: var(--color-cream);
    flex-shrink: 0;
  }

  .page-header h1 {
    margin-top: 0.6rem;
    font-size: clamp(1.625rem, 3vw, 2.375rem);
    color: #fff;
  }

  .intro {
    margin: 0.75rem auto 0;
    font-size: 0.94rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.55;
    max-width: 56ch;
  }

  .ph-region {
    margin: 0.9rem auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: fit-content;
    font-size: 0.8125rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.85);
  }

  .ph-region svg {
    width: 14px;
    height: 14px;
  }

  .concept-details {
    background: #fff;
    padding: clamp(3rem, 6vw, 3.5rem) 0;
  }

  .concept-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.25rem;
    align-items: center;
  }

  .ph-photo {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 400px;
    object-fit: cover;
    transition: transform var(--transition);
  }

  .ph-photo:hover {
    transform: translateY(-4px);
  }

  .benefit-list {
    display: grid;
    grid-template-columns: max-content;
    gap: 0.4rem;
  }

  .benefit-row {
    max-width: 100%;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: var(--color-cream-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.9rem;
    transition: background var(--transition), transform var(--transition), border-color var(--transition);
  }

  .benefit-row:hover {
    background: #fff;
    transform: translateX(4px);
    border-color: var(--color-wine);
  }

  .benefit-row :global(svg) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--color-wine);
  }

  .benefit-row span {
    font-size: 0.81rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .benefit-row.highlight {
    background: var(--color-wine);
    border-color: var(--color-wine);
    flex-direction: column;
    align-items: flex-start;
    padding: 0.85rem 1rem;
    width: 220px;
    max-width: 100%;
    margin-top: 1rem;
  }

  .benefit-row.highlight:hover {
    transform: none;
  }

  .benefit-row.highlight .pct {
    font-size: 1.85rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-cream);
  }

  .benefit-row.highlight .desc {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: rgba(247, 240, 230, 0.85);
    line-height: 1.35;
  }

  .how {
    background: var(--color-olive-muted);
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
  }

  .how-head {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .eyebrow-light {
    justify-content: center;
    color: rgba(255, 255, 255, 0.7);
  }

  .eyebrow-light .rule {
    background: rgba(255, 255, 255, 0.7);
  }

  .how-head h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.85rem, 3.2vw, 2.4rem);
    color: #fff;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }

  .pricing {
    padding: clamp(2rem, 5vw, 2.5rem) 0;
  }

  .pricing-toggle {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.15rem;
    flex-wrap: wrap;
  }

  .toggle-pill {
    background: var(--color-cream-card);
    border: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    padding: 0.7rem 1.35rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    transition: all var(--transition);
  }

  .toggle-pill:hover {
    border-color: var(--color-wine);
  }

  .toggle-pill.active {
    background: var(--color-wine);
    border-color: var(--color-wine);
    color: #fff;
  }

  .toggle-pill .save {
    display: inline-block;
    margin-left: 0.4rem;
    font-size: 0.65rem;
    font-weight: 800;
    background: var(--color-olive);
    color: #fff;
    padding: 0.15rem 0.45rem;
    border-radius: 10px;
  }

  .toggle-pill.active .save {
    background: rgba(255, 255, 255, 0.25);
  }

  .pricing-head {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 0.85rem;
  }

  .pricing-head .eyebrow {
    color: var(--color-olive-dark);
  }

  .pricing-head h2 {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    color: var(--color-wine);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    max-width: 1140px;
    margin: 0 auto;
  }

  .pricing-cta {
    text-align: center;
    margin-top: 1.25rem;
  }

  .cta-link {
    display: inline-block;
    background: var(--color-wine);
    color: #fff;
    padding: 1.1rem 2.6rem;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform var(--transition), box-shadow var(--transition), background var(--transition);
  }

  .cta-link:hover {
    background: var(--color-wine-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .advantage-banner {
    background: var(--color-olive-muted);
    padding: clamp(2.5rem, 5vw, 3rem) 0;
  }

  .advantage-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: nowrap;
  }

  .advantage-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.25rem;
    min-width: 0;
  }

  .advantage-icon {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-cream);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .advantage-icon svg {
    width: 19px;
    height: 19px;
    color: var(--color-wine);
  }

  .advantage-item .t {
    font-size: 0.875rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.25;
  }

  .advantage-item .s {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.82);
    margin-top: 0.2rem;
    line-height: 1.35;
  }

  .advantage-divider {
    width: 1px;
    height: 44px;
    background: rgba(255, 255, 255, 0.28);
    flex-shrink: 0;
  }

  .pour-qui {
    background: #fff;
    padding: clamp(3.5rem, 7vw, 4rem) 0;
  }

  .pour-qui .section-head {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 2.75rem;
  }

  .pour-qui .eyebrow {
    justify-content: center;
    color: var(--color-olive-dark);
  }

  .pour-qui .rule {
    display: none;
  }

  .pour-qui .section-head h2 {
    margin-top: 0.625rem;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    color: var(--color-wine);
  }

  .profil-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.625rem;
  }

  .profil-card {
    background: var(--color-cream-card);
    border-radius: var(--radius-md);
    padding: 1.875rem 1.625rem;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .profil-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .profil-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-wine);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .profil-icon svg {
    width: 20px;
    height: 20px;
    color: #fff;
  }

  .profil-card h3 {
    font-size: 1.125rem;
    color: var(--color-wine);
  }

  .profil-pain {
    margin-top: 0.625rem;
    font-size: 0.84rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
    font-style: italic;
  }

  .profil-solution {
    margin-top: 0.625rem;
    font-size: 0.84rem;
    color: var(--color-ink);
    line-height: 1.55;
  }

  .profil-solution strong {
    color: var(--color-wine);
  }

  @media (max-width: 980px) {
    .advantage-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .advantage-divider {
      display: none;
    }

    .advantage-item {
      padding: 0;
    }

    .profil-grid {
      grid-template-columns: 1fr;
    }

    .concept-grid {
      grid-template-columns: 1fr;
    }

    .ph-photo {
      order: -1;
      height: auto;
      aspect-ratio: 3 / 4;
      min-height: 0;
      max-width: 320px;
      margin: 0 auto;
    }

    .steps-grid {
      grid-template-columns: 1fr;
    }

    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
