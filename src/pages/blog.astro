---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, blogArticles } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog ${site.name}`,
  description: 'Conseils cuisine et astuces batchcooking pour organiser vos repas de la semaine.',
  url: `${site.url}/blog`,
  publisher: {
    '@type': 'LocalBusiness',
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout
  title="Blog — Conseils cuisine & astuces batchcooking"
  description="Conseils, astuces et bonnes pratiques pour organiser vos repas, gagner du temps en cuisine et profiter du batchcooking à domicile."
  canonicalPath="/blog"
  jsonLd={jsonLd}
>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">
        <span class="rule"></span>
        Le blog
        <span class="rule"></span>
      </p>
      <h1>Conseils cuisine &amp; astuces batchcooking</h1>
      <p class="intro">
        Des conseils pratiques pour organiser vos repas, gagner du temps en cuisine et profiter au mieux de
        votre semaine.
      </p>
    </div>
  </section>

  <section class="articles">
    <div class="container">
      {
        blogArticles.length === 0 ? (
          <div class="articles-empty">Les premiers articles arrivent bientôt !</div>
        ) : (
          <div class="articles-grid">
            {blogArticles.map((article) => (
              <a href={`/blog/${article.slug}`} class="article-card">
                <img class="article-img" src="/images/photo-action-2.webp" alt={article.title} />
                <div class="article-body">
                  <span class="article-tag">{article.tag}</span>
                  <h2 class="article-title">{article.title}</h2>
                  <p class="article-excerpt">{article.excerpt}</p>
                  <div class="article-meta">
                    <span>{article.date} &middot; {article.readTime}</span>
                    <span class="read-link">Lire →</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(155deg, var(--color-wine) 0%, var(--color-mauve) 65%, var(--color-wine-deeper) 100%);
    color: #fff;
    padding: clamp(1.85rem, 4vw, 2.1rem) 0 clamp(2.1rem, 4vw, 2.4rem);
    text-align: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: var(--color-cream);
    font-size: 0.75rem;
  }

  .rule {
    width: 22px;
    height: 1px;
    background: var(--color-cream);
    flex-shrink: 0;
  }

  h1 {
    margin-top: 0.6rem;
    font-size: clamp(1.625rem, 3vw, 2.375rem);
    color: #fff;
  }

  .intro {
    margin: 0.75rem auto 0;
    font-size: 0.94rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.55;
    max-width: 56ch;
  }

  .articles {
    padding: clamp(3rem, 6vw, 4rem) 0 clamp(4rem, 7vw, 5.5rem);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .article-card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .article-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .article-img {
    aspect-ratio: 16 / 10;
    width: 100%;
    object-fit: cover;
    border-bottom: 1px solid var(--color-line);
  }

  .article-body {
    padding: 1.375rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .article-tag {
    font-size: 0.69rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-wine);
  }

  .article-title {
    margin-top: 0.625rem;
    font-size: 1.125rem;
    color: var(--color-ink);
    font-weight: 800;
    line-height: 1.3;
  }

  .article-excerpt {
    margin-top: 0.625rem;
    font-size: 0.84rem;
    color: var(--color-ink-soft);
    line-height: 1.55;
    flex-grow: 1;
  }

  .article-meta {
    margin-top: 1.1rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.75rem;
    color: var(--color-ink-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .article-meta .read-link {
    color: var(--color-wine);
    font-weight: 700;
  }

  .articles-empty {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    background: #fff;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-md);
    padding: 2.5rem 2rem;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  @media (max-width: 980px) {
    .articles-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
