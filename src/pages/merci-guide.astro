---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Merci !"
  description="Votre demande de guide a bien été reçue."
  canonicalPath="/merci-guide"
>
  <section class="merci">
    <div class="container merci-inner">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5" />
      </svg>
      <h1>Merci !</h1>
      <p>
        Votre demande a bien été reçue. Vous recevrez votre guide sur le batchcooking à domicile par email
        très prochainement.
      </p>
      <a href="/" class="cta-link">Retour à l&rsquo;accueil</a>
    </div>
  </section>
</BaseLayout>

<style>
  .merci {
    background: linear-gradient(155deg, var(--color-wine) 0%, var(--color-mauve) 65%, var(--color-wine-deeper) 100%);
    color: #fff;
    padding: clamp(4rem, 10vw, 6rem) 0;
    min-height: 50vh;
    display: flex;
    align-items: center;
  }

  .merci-inner {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
  }

  .merci-inner svg {
    width: 48px;
    height: 48px;
    margin: 0 auto;
    padding: 0.75rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-cream);
  }

  .merci-inner h1 {
    margin-top: 1.25rem;
    font-size: clamp(1.75rem, 3.4vw, 2.375rem);
    color: #fff;
  }

  .merci-inner p {
    margin-top: 0.875rem;
    font-size: 0.94rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.6;
  }

  .cta-link {
    display: inline-block;
    margin-top: 1.75rem;
    background: var(--color-cream);
    color: var(--color-wine-deeper);
    padding: 0.9375rem 1.875rem;
    border-radius: var(--radius-md);
    font-weight: 800;
    font-size: 0.9rem;
    text-decoration: none;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .cta-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
</style>
