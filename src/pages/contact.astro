---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';
---

<BaseLayout title="Contact" description="Demandez votre devis pour une prestation de batchcooking à domicile.">
  <section class="contact">
    <div class="container">
      <h1>Demander mon devis</h1>
      <p>
        Cette page est en cours de construction. En attendant, contactez-moi directement par email à
        <a href={`mailto:${contact.email}`}>{contact.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    background: var(--color-cream);
    padding-block: var(--space-section);
    min-height: 40vh;
  }

  .contact h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: 1.25rem;
  }

  .contact p {
    max-width: 50ch;
  }

  .contact a {
    color: var(--color-burgundy);
    font-weight: 700;
  }
</style>
