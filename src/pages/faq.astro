---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';
---

<BaseLayout title="FAQ" description="Questions fréquentes sur le batchcooking à domicile.">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">
        <span class="rule"></span>
        Questions fréquentes
      </p>
      <h1>FAQ</h1>
      <p class="intro">Cette page est en cours de rédaction — le détail arrive bientôt.</p>
    </div>
  </section>

  <section class="content">
    <div class="container">
      <p>
        En attendant le détail complet de cette page, n&rsquo;hésitez pas à me contacter directement pour
        toute question : <a href={`mailto:${contact.email}`}>{contact.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(155deg, var(--color-wine) 0%, var(--color-mauve) 65%, var(--color-wine-deeper) 100%);
    color: #fff;
    padding: clamp(2.25rem, 5vw, 2.75rem) 0 clamp(2.5rem, 5vw, 3rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-cream);
  }

  .rule {
    width: 22px;
    height: 1px;
    background: var(--color-cream);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2.1rem, 3.6vw, 2.85rem);
    color: #fff;
  }

  .intro {
    margin-top: 1.15rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    max-width: 52ch;
  }

  .content {
    padding: clamp(3rem, 6vw, 4.5rem) 0;
    min-height: 30vh;
  }

  .content p {
    max-width: 60ch;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-soft);
  }

  .content a {
    color: var(--color-wine);
    font-weight: 700;
  }
</style>
