---
import { optionsFormules, formules } from '../data/site';

type Formule = (typeof formules)[number];

interface Props {
  formule: Formule;
}

const { formule } = Astro.props;
const { ponctuel, mensuel2, mensuel4 } = formule.prix;
---

<div class="plan" data-plan={formule.id}>
  <h3>{formule.nom}</h3>
  <span class="from">à partir de</span>
  <div class="price" data-real={ponctuel.avant} data-real2={mensuel2.avant} data-real4={mensuel4.avant}>
    {ponctuel.avant}&nbsp;&euro;
  </div>
  <p class="credit-pill">
    soit <strong class="amount" data-credit={ponctuel.client} data-credit2={mensuel2.client} data-credit4={mensuel4.client}>{ponctuel.client}&nbsp;&euro;</strong> après
    crédit d&rsquo;impôt*
  </p>
  <div class="engagement-slot"></div>
  <ul class="plan-features">
    {formule.avantages.map((avantage) => <li>{avantage}</li>)}
  </ul>
  <div class="plan-more">
    <p class="options-title">Options disponibles</p>
    <ul class="plan-options">
      {
        optionsFormules.map((option) => (
          <li>
            {option.label} <span class="opt-price">{option.prix}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .plan {
    background: var(--color-wine);
    color: #fff;
    border-radius: var(--radius-md);
    padding: 2.25rem 2.25rem 1.875rem;
    position: relative;
    border: 1px solid transparent;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  .plan:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-olive);
  }

  .plan h3 {
    font-size: 0.9375rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cream);
    font-weight: 800;
  }

  .from {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
    display: block;
    margin-top: 1.375rem;
  }

  /* Prix réel (avant crédit d'impôt) : information principale, en grand. */
  .price {
    margin-top: 0.25rem;
    font-size: 58px;
    font-weight: 900;
    line-height: 1;
    color: #fff;
    letter-spacing: -0.02em;
  }

  /* Crédit d'impôt : mention séparée, nettement plus petite, jamais mise en avant. */
  .credit-pill {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-top: 16px;
    padding: 9px 14px;
    border-radius: var(--radius-md);
    background: rgba(250, 243, 237, 0.14);
    border: 1px solid rgba(250, 243, 237, 0.4);
    color: var(--color-cream);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
  }

  .credit-pill .amount {
    font-weight: 800;
  }

  .engagement-slot :global(.engagement-badge) {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(250, 243, 237, 0.7);
    color: var(--color-cream);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .plan-features {
    margin-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .plan-features li {
    padding: 0.8125rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 0.9375rem;
    font-weight: 600;
    color: #fff;
  }

  .plan-more {
    margin-top: 1rem;
  }

  .options-title {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .plan-options {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .plan-options li {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.4;
  }

  .opt-price {
    display: block;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
  }

  @media (max-width: 560px) {
    .plan {
      padding: 1.875rem 1.5rem;
    }

    .price {
      font-size: 50px;
    }

    .credit-pill {
      font-size: 18px;
    }
  }
</style>
