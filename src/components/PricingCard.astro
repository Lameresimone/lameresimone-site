---
import type { formules } from '../data/site';

type Formule = (typeof formules)[number];

interface Props {
  formule: Formule;
}

const { formule } = Astro.props;
---

<div class="pricing-card">
  <p class="pricing-name">{formule.nom}</p>
  <p class="pricing-from">à partir de</p>
  <p class="pricing-price">{formule.prixApresCredit}&euro;</p>
  <p class="pricing-before-credit">
    soit {formule.prixAvantCredit}&euro; avant crédit d&rsquo;impôt*<br />
    Tarif hors prix des courses
  </p>
  <ul class="pricing-features">
    {formule.avantages.map((avantage) => <li>{avantage}</li>)}
  </ul>
  <p class="pricing-footnote">
    *Tarif pour {formule.nbPlats} plats de {formule.nbPortions} portions
  </p>
</div>

<style>
  .pricing-card {
    background: var(--color-burgundy);
    color: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem 1.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .pricing-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .pricing-name {
    text-align: center;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.92rem;
    margin: 0;
  }

  .pricing-from {
    text-align: center;
    margin: 0;
    opacity: 0.75;
    font-size: 0.9rem;
  }

  .pricing-price {
    text-align: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 3.5rem;
    margin: 0.1rem 0 0.2rem;
  }

  .pricing-before-credit {
    background: var(--color-cream);
    color: var(--color-burgundy);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
    margin: 0.3rem 0;
  }

  .pricing-features {
    list-style: none;
    padding: 0;
    margin: 0.3rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.95rem;
  }

  .pricing-features li {
    position: relative;
    padding-left: 1.4rem;
  }

  .pricing-features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-cream);
    opacity: 0.6;
  }

  .pricing-footnote {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    font-style: italic;
    opacity: 0.7;
  }
</style>
