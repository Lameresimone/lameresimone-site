---
import { contact, footerNav } from '../data/site';

const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-cols">
      <div class="footer-col">
        <h5>Navigation</h5>
        {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="footer-col">
        <h5>Contact</h5>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={contact.instagramUrl} target="_blank" rel="noopener noreferrer">
          {contact.instagram}
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>SIRET {contact.siret}</span>
      <span>|</span>
      <a href="/mentions-legales">Mentions légales &amp; CGV</a>
      <span>|</span>
      <span>&copy; {year} La mère Simone — Tous droits réservés</span>
    </div>
    <div class="sap-placeholder">Logo<br />SAP</div>
  </div>
</footer>

<style>
  footer {
    background: var(--color-olive-dark);
    color: rgba(247, 240, 230, 0.75);
    padding: 2.5rem 0 1rem;
    position: relative;
  }

  .sap-placeholder {
    position: absolute;
    right: clamp(1.25rem, 4vw, 2.5rem);
    bottom: 1rem;
    width: 44px;
    height: 44px;
    border: 1px dashed rgba(247, 240, 230, 0.35);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 8px;
    line-height: 1.3;
    color: rgba(247, 240, 230, 0.45);
  }

  .footer-cols {
    display: flex;
    justify-content: center;
    gap: 3.5rem;
    flex-wrap: wrap;
    padding-bottom: 1.5rem;
    text-align: center;
  }

  .footer-col h5 {
    font-size: 0.65rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(247, 240, 230, 0.4);
    margin-bottom: 0.5rem;
    font-weight: 800;
  }

  .footer-col a,
  .footer-col span {
    display: block;
    font-size: 0.8rem;
    color: rgba(247, 240, 230, 0.75);
    text-decoration: none;
    padding-block: 0.15rem;
    transition: color var(--transition);
  }

  .footer-col a:hover {
    color: #fff;
  }

  .footer-bottom {
    text-align: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(247, 240, 230, 0.12);
    font-size: 0.7rem;
    color: rgba(247, 240, 230, 0.4);
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .footer-bottom a {
    color: rgba(247, 240, 230, 0.55);
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-bottom a:hover {
    color: #fff;
  }

  @media (max-width: 560px) {
    footer {
      padding-bottom: 4rem;
    }
  }
</style>
