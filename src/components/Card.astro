---
interface Props {
  variant?: 'cream' | 'mauve';
}

const { variant = 'cream' } = Astro.props;
---

<div class:list={['card', `card-${variant}`]}>
  {Astro.slots.has('icon') && (
    <div class="card-icon">
      <slot name="icon" />
    </div>
  )}
  <div class="card-body">
    <slot />
  </div>
</div>

<style>
  .card {
    border-radius: var(--radius-md);
    padding: 1.5rem 1.65rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .card-cream {
    background: var(--color-cream);
    color: var(--color-burgundy);
  }

  .card-mauve {
    background: var(--color-mauve);
    color: var(--color-cream);
  }

  .card-icon {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 0.4rem;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .card-body :global(strong) {
    display: block;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .card-body :global(span) {
    display: block;
    font-size: 0.88rem;
    letter-spacing: 0.03em;
    opacity: 0.75;
  }
</style>
