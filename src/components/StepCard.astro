---
interface Props {
  numero: string;
  titre: string;
  texte: string;
}

const { numero, titre, texte } = Astro.props;
---

<div class="step-card">
  <p class="step-number">{numero}</p>
  <h3>{titre}</h3>
  <p class="step-text">{texte}</p>
</div>

<style>
  .step-card {
    background: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .step-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .step-number {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 2.75rem;
    color: var(--color-burgundy);
    margin: 0 0 1.1rem;
    padding-bottom: 0.85rem;
    border-bottom: 2px solid color-mix(in srgb, var(--color-burgundy) 30%, transparent);
    display: inline-block;
  }

  .step-card h3 {
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-burgundy);
    margin: 1.1rem 0 0.6rem;
  }

  .step-text {
    color: var(--color-burgundy);
    opacity: 0.75;
    font-size: 0.98rem;
    line-height: 1.6;
  }
</style>
