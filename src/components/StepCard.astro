---
interface Props {
  numero: string;
  titre: string;
  texte: string;
}

const { numero, titre, texte } = Astro.props;
---

<div class="step-card">
  <p class="step-number">{numero}</p>
  <h3>{titre}</h3>
  <p class="step-text">{texte}</p>
</div>

<style>
  .step-card {
    background: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--color-burgundy);
    margin: 0 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid var(--color-burgundy);
    display: inline-block;
  }

  .step-card h3 {
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-burgundy);
    margin: 1rem 0 0.5rem;
  }

  .step-text {
    color: var(--color-burgundy);
    opacity: 0.85;
    font-size: 0.98rem;
  }
</style>
