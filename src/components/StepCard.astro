---
interface Props {
  numero: string;
  titre: string;
  texte: string;
}

const { numero, titre, texte } = Astro.props;
---

<div class="step-card">
  <span class="n">{numero}</span>
  <h3>{titre}</h3>
  <p>{texte}</p>
</div>

<style>
  .step-card {
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 2.25rem 1.9rem;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .step-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .n {
    font-weight: 900;
    font-size: 2.25rem;
    color: var(--color-wine);
    opacity: 0.35;
  }

  .step-card h3 {
    margin-top: 0.9rem;
    font-size: 1.2rem;
    color: var(--color-wine);
  }

  .step-card p {
    margin-top: 0.65rem;
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
  }
</style>
