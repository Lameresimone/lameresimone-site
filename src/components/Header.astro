---
import { nav, navCta } from '../data/site';

const currentPath = Astro.url.pathname;
---

<div class="brand-bar"></div>
<header>
  <nav class="nav container">
    <a href="/" class="logo">
      <img src="/images/logo.png" alt="La mère Simone" />
    </a>
    <ul class="nav-links" id="nav-links">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class:list={{ active: currentPath === item.href }}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={navCta.href} class="nav-cta">
          {navCta.label}
        </a>
      </li>
    </ul>
    <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<script>
  const burger = document.getElementById('burger');
  const navLinks = document.getElementById('nav-links');

  burger?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>

<style>
  .brand-bar {
    height: 5px;
    background: var(--color-olive);
  }

  header {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-line);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1rem;
  }

  .logo {
    display: inline-flex;
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .logo:hover {
    opacity: 0.85;
  }

  .logo img {
    height: 2.75rem;
    width: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .nav-links a {
    position: relative;
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--color-olive-dark);
    text-decoration: none;
    transition: color var(--transition);
  }

  .nav-links a:hover {
    color: var(--color-wine);
  }

  .nav-links a.active {
    color: var(--color-wine);
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-olive);
  }

  .nav-cta {
    background: var(--color-olive);
    color: #fff !important;
    padding: 0.75rem 1.5rem !important;
    border-radius: var(--radius-md);
    transition: background var(--transition), transform var(--transition);
  }

  .nav-cta::after {
    display: none !important;
  }

  .nav-cta:hover {
    background: var(--color-olive-dark);
    color: #fff;
    transform: translateY(-1px);
  }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
  }

  .burger span {
    width: 24px;
    height: 2px;
    background: var(--color-ink);
    display: block;
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-cream);
      border-bottom: 1px solid var(--color-line);
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      padding: 1rem clamp(1.25rem, 4vw, 2.5rem) 1.5rem;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links li {
      width: 100%;
    }

    .nav-cta {
      display: inline-block;
      margin-top: 0.5rem;
    }

    .nav {
      position: relative;
    }

    .burger {
      display: flex;
    }
  }
</style>
