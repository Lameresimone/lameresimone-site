---
import { nav, navCta, brandBarMessage } from '../data/site';

const currentPath = Astro.url.pathname;
---

<div class="brand-bar" class:list={{ 'has-message': Boolean(brandBarMessage) }}>
  {brandBarMessage && <p>{brandBarMessage}</p>}
</div>
<header>
  <nav class="nav container">
    <a href="/" class="logo">
      <img src="/images/logo.png" alt="La mère Simone" />
    </a>
    <ul class="nav-links" id="nav-links">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class:list={{ active: currentPath === item.href }}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={navCta.href} class="nav-cta" id="nav-cta">
      {navCta.label}
    </a>
    <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<script>
  const burger = document.getElementById('burger');
  const navLinks = document.getElementById('nav-links');
  const navCta = document.getElementById('nav-cta');

  burger?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    navCta?.classList.toggle('open', Boolean(isOpen));
    burger.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });
</script>

<style>
  .brand-bar {
    min-height: 5px;
    background: var(--color-olive);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .brand-bar.has-message {
    min-height: 38px;
    padding: 0.4rem 1.25rem;
  }

  .brand-bar p {
    margin: 0;
  }

  header {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-line);
  }

  .nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 1.5rem;
    padding-block: 1rem;
  }

  .logo {
    display: inline-flex;
    text-decoration: none;
    transition: opacity var(--transition);
  }

  .logo:hover {
    opacity: 0.85;
  }

  .logo img {
    height: 2.75rem;
    width: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .nav-links a {
    position: relative;
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--color-olive-dark);
    text-decoration: none;
    transition: color var(--transition);
  }

  .nav-links a:hover {
    color: var(--color-wine);
  }

  .nav-links a.active {
    color: var(--color-wine);
  }

  .nav-links a.active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-olive);
  }

  .nav-cta {
    background: var(--color-olive);
    color: #fff;
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius-md);
    font-size: 0.87rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    justify-self: end;
    transition: background var(--transition), transform var(--transition);
  }

  .nav-cta:hover {
    background: var(--color-olive-dark);
    transform: translateY(-1px);
  }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
  }

  .burger span {
    width: 24px;
    height: 2px;
    background: var(--color-ink);
    display: block;
  }

  @media (max-width: 900px) {
    .nav {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }

    .nav-links,
    .nav-cta {
      display: none;
    }

    .nav-links.open {
      display: flex;
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--color-line);
    }

    .nav-cta.open {
      display: inline-flex;
      flex-basis: 100%;
      justify-self: auto;
      margin-top: 0.75rem;
    }

    .burger {
      display: flex;
    }
  }
</style>
