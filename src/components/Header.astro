---
import { nav } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header>
  <div class="nav-bar">
    <nav class="container">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="logo-bar">
    <div class="container">
      <a href="/" class="logo">
        <span class="logo-la-mere">La mère</span>
        <span class="logo-simone">Simone</span>
      </a>
    </div>
  </div>
</header>

<style>
  .nav-bar {
    background: var(--color-olive);
  }

  .nav-bar nav {
    display: flex;
    justify-content: flex-end;
  }

  .nav-bar ul {
    list-style: none;
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    margin: 0;
    padding: 0.85rem 0;
  }

  .nav-bar a {
    color: var(--color-cream);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    opacity: 0.85;
  }

  .nav-bar a:hover,
  .nav-bar a[aria-current='page'] {
    opacity: 1;
  }

  .logo-bar {
    background: var(--color-cream);
    padding-block: 1.25rem;
  }

  .logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 0.85;
    text-decoration: none;
    color: var(--color-burgundy);
  }

  .logo-la-mere {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .logo-simone {
    font-family: var(--font-display);
    font-size: 2.5rem;
  }
</style>
